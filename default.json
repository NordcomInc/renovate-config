{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":labels(Dependency)",
        ":rebaseStalePrs",
        ":disableRateLimiting",
        ":semanticCommitsDisabled",
        ":automergeMajor"
    ],
    "gradle": {
        "enabled": true
    },
    "gradle-wrapper": {
        "enabled": true
    },
    "maven": {
        "enabled": true
    },
    "python": {
        "enabled": true
    },
    "bundler": {
        "enabled": true
    },
    "travis": {
        "enabled": false
    },
    "branchPrefix": "deps/bot-",
    "allowCustomCrateRegistries": true,
    "allowScripts": true,
    "exposeAllEnv": true,
    "onboardingPrTitle": "Configure automatic dependency management",
    "onboarding": false,
    "commitMessage": "{{{commitMessagePrefix}}}{{{commitMessageAction}}} {{{commitMessageTopic}}} {{{commitMessageExtra}}}{{{commitMessageSuffix}}}",
    "commitMessagePrefix": "chore(deps): ",
    "commitMessageSuffix": "",
    "commitMessageAction": "update",
    "gitIgnoredAuthors": ["*"],
    "prConcurrentLimit": 3,
    "prHeader": "> [!WARNING]\n> Renovate manages this PR automatically. Manual changes to this branch may be overwritten. The PR and branch may be deleted when the update is no longer needed.",
    "prBodyTemplate": "{{{header}}}{{{table}}}{{{warnings}}}{{{notes}}}{{{changelogs}}}{{{configDescription}}}{{{controls}}}{{{footer}}}",
    "fetchReleaseNotes": true
}
