{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":configMigration",
        ":labels(Dependency)",
        ":rebaseStalePrs",
        ":disableRateLimiting",
        ":semanticCommits",
        ":semanticCommitTypeAll(chore)",
        ":automergeAll",
        ":maintainLockFilesWeekly",
        "helpers:pinGitHubActionDigests",
        "docker:pinDigests"
    ],
    "gradle": {
        "enabled": true
    },
    "gradle-wrapper": {
        "enabled": true
    },
    "maven": {
        "enabled": true
    },
    "python": {
        "enabled": true
    },
    "bundler": {
        "enabled": true
    },
    "travis": {
        "enabled": false
    },
    "branchPrefix": "deps/bot-",
    "allowCustomCrateRegistries": true,
    "allowScripts": true,
    "exposeAllEnv": true,
    "onboardingPrTitle": "Configure automatic dependency management",
    "onboarding": true,
    "gitIgnoredAuthors": ["*"],
    "prConcurrentLimit": 3,
    "prHeader": "> [!WARNING]\n> Renovate manages this PR automatically. Manual changes to this branch may be overwritten. The PR and branch may be deleted when the update is no longer needed.",
    "prFooter": "✨ Brought to you by [Filiph Sandström](https://github.com/filiphsps) · dependency updates powered by [Renovate](https://github.com/renovatebot/renovate).",
    "prBodyTemplate": "{{{header}}}{{{table}}}{{{warnings}}}{{{notes}}}{{{changelogs}}}{{{configDescription}}}{{{controls}}}{{{footer}}}",
    "fetchReleaseNotes": true
}
